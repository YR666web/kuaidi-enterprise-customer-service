# ============================================================
# 快递企业智能客服 环境变量示例
# 复制为 .env 后按需修改；字段命名规则：<层级>__<字段>（双下划线）
# 不设置时使用 config.py 中的默认值（本机裸跑，无需 Docker）
# ============================================================

# ----- 应用 -----
APP__DEBUG=false
APP__ENVIRONMENT=development
APP__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ----- 数据库（开发期默认 SQLite；阶段 9 切换 MySQL：mysql+pymysql://...）-----
DATABASE__URL=sqlite:///./stacklang.db
DATABASE__ECHO=false

# ----- Redis（LangGraph checkpoint；开发期可用 MemorySaver 替代）-----
REDIS__URL=redis://localhost:6379/0

# ----- Neo4j 知识图谱 -----
NEO4J__URI=bolt://localhost:7687
NEO4J__USER=neo4j
NEO4J__PASSWORD=neo4j

# ----- Chroma 向量库（进程内运行，持久化目录）-----
CHROMA__PERSIST_DIR=./data/chroma
CHROMA__COLLECTION=knowledge_base

# ----- 向量模型（bge-base-zh-v1.5，本地缓存于项目根 models/）-----
EMBEDDING__MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING__CACHE_DIR=../models
EMBEDDING__DEVICE=cpu

# ----- LLM（DeepSeek，OpenAI 兼容）-----
LLM__PROVIDER=deepseek
LLM__MODEL=deepseek-chat
LLM__API_KEY=
LLM__BASE_URL=https://api.deepseek.com
LLM__TEMPERATURE=0.0
LLM__FAST_MODEL=deepseek-flash
LLM__REASONING_MODEL=deepseek-v4-pro
LLM__FAST_MAX_TOKENS=320
LLM__REASONING_MAX_TOKENS=2048
LLM__REASONING_EFFORT=high

# ----- 编排层（LangGraph）-----
# development 可用 memory；production 必须配置 redis，且要有可访问的 Redis 服务。
AGENT__CHECKPOINT_BACKEND=memory
AGENT__MAX_ACTIONS=8

# ----- 多轮业务办理（Workflow）-----
WORKFLOW__FLOWS_DIR=data/flows

# ----- 订单 / 物流 / 售后供应商 -----
# local：本地数据库；demo：明确标记的沙盒供应商；http：已授权企业网关。
BUSINESS_INTEGRATION__PROVIDER=local
BUSINESS_INTEGRATION__BASE_URL=
BUSINESS_INTEGRATION__API_TOKEN=
BUSINESS_INTEGRATION__TIMEOUT_SECONDS=5
BUSINESS_INTEGRATION__MAX_RETRIES=2
BUSINESS_INTEGRATION__CIRCUIT_FAILURE_THRESHOLD=3
BUSINESS_INTEGRATION__CIRCUIT_RESET_SECONDS=30

# ----- 检索底座（retrieval）-----
RETRIEVAL__QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
RETRIEVAL__RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL__RRF_K=60
RETRIEVAL__TOP_K=5
RETRIEVAL__BM25_BACKEND=rank_bm25

# ----- RAG 知识问答 -----
RAG__CHUNK_SIZE=512
RAG__CHUNK_OVERLAP=64
RAG__TOP_K=4
RAG__SCORE_THRESHOLD=0.3
RAG__NO_ANSWER_REPLY=抱歉，未在知识库中找到与您问题相关的答案。

# ----- GraphRAG 图谱问答 -----
GRAPHRAG__MAX_RETRIES=3
GRAPHRAG__ENTRY_TOP_K=3

# ----- 平台能力（多租户/RBAC/监控/审计）-----
PLATFORM__JWT_SECRET=dev-secret-change-me-please-override-32
PLATFORM__JWT_ALGORITHM=HS256
# 生产环必须替换为至少 32 位随机密钥，且不能以 dev-secret- 开头
PLATFORM__RATE_LIMIT_BACKEND=memory
PLATFORM__RATE_LIMIT_REQUESTS=60
PLATFORM__RATE_LIMIT_WINDOW_SECONDS=60
PLATFORM__ERROR_RATE_THRESHOLD=0.05
PLATFORM__LATENCY_THRESHOLD_MS=3000
PLATFORM__DEGRADATION_THRESHOLD=10
